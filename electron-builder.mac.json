{
    "appId": "com.drankee.bitura",
    "productName": "Bitura Wallet",
    "files": ["dist-electron", "dist-react", "src/assets"],
    "extraResources": [
      {
        "from": "java/BituraUtils.jar",
        "to": "java/BituraUtils.jar"
      },
      {
        "from": "java/jdk-mac",
        "to": "java/jdk-mac"
      }
    ],
    "icon": "src/assets/logoBituraMac.png",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "background": "src/assets/dmg-background.png",
      "iconSize": 100,
      "contents": [
        { "x": 110, "y": 330 },
        { "x": 530, "y": 330, "type": "link", "path": "/Applications" }
      ]
    }
  }
  