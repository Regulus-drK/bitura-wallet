{
  "name": "bitura-wallet",
  "private": true,
  "version": "1.1.0",
  "module": "ESNext",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Jorge Puentes",
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json && tsc --project src/electron/tsconfig.preload.json",
    "dist:win": "npm run transpile:electron && npm run build && electron-builder --config electron-builder.win.json --win --x64",
    "dist:mac": "npm run transpile:electron && npm run build && electron-builder --config electron-builder.mac.json --mac --arm64",
    "dist:linux": "npm run transpile:electron && npm run build && electron-builder --config electron-builder.linux.json --linux --x64"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "bignumber.js": "^9.3.0",
    "bip32": "^5.0.0-rc.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.7",
    "buffer": "^6.0.3",
    "ecpair": "^3.0.0",
    "electron-store": "^10.0.1",
    "ethers": "^6.14.0",
    "framer-motion": "^12.15.0",
    "lucide-react": "^0.508.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.1.5",
    "tiny-secp256k1": "^2.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/electron-store": "^1.3.1",
    "@types/node": "^22.15.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-wasm": "^3.4.1"
  }
}
