{
    "appId": "com.drankee.bitura",
    "productName": "Bitura Wallet",
    "files": ["dist-electron", "dist-react", "build"],
    "icon": "build/favicon.ico",
    "mac": {
        "target": "dmg",
          "category": "public.app-category.utilities"
    },
    "linux": {
        "target": "AppImage",
        "category": "Utility"
    },
    "win": {
        "target": ["portable", "nsis"]
    },

    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true, 
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true
    },
    "dmg": {
    "background": "build/dmg-background.png",
    "iconSize": 100,
    "contents": [
        {
        "x": 130,
        "y": 220
        },
        {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
        }
    ]
    }
}